# Compiled releases also lock paid AI off in next.config.ts.
# Deterministic browser analysis needs no credentials.
# Server heuristic drafting sends text to ResumeScore, but no external AI provider.
# External paid AI stays disabled unless ALL budget configuration is valid.
AI_PAID_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Server-only Redis REST endpoint/token; do not use NEXT_PUBLIC_ prefixes.
AI_BUDGET_REDIS_URL=
AI_BUDGET_REDIS_TOKEN=
AI_DAILY_BUDGET_MICROUSD=
# Verify current provider pricing for the explicitly selected model first.
AI_INPUT_MICROUSD_PER_MILLION_TOKENS=
AI_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
AI_PRICED_MODEL=
AI_MODEL_COST_REVIEWED=false
# See docs/AI_COST_CONTROLS.md. No service is created by this configuration.
