# Environment Variables
# Copy this file to .env.local and fill in your values

# No environment variables are required for basic usage.
# The 7-pillar scoring engine and client-side PDF extraction work 100% offline.

# Optional LLM Integration:
# ResumeScore supports both Anthropic (Claude) and Google (Gemini) providers.
# Selection priority:
# 1. ANTHROPIC_API_KEY (if present, ClaudeAIProvider is active)
# 2. GEMINI_API_KEY or GOOGLE_API_KEY (if present, GeminiAIProvider is active)
# 3. If neither is set, ResumeScore runs in 100% offline heuristic mode.

# Option A: Anthropic Claude (claude-sonnet-5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option B: Google Gemini (default: gemini-3.6-flash, or set GEMINI_MODEL)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

